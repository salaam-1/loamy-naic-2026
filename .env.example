# Loamy Platform — points at the SAME Supabase project as the Founding Member Portal.
# Paste the exact same values the portal uses. The anon key is safe for the browser;
# NEVER put the service_role key in this file or anywhere in this app.
VITE_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Marketplace escrow (Paystack). The PUBLIC key is browser-safe and only gates
# the Pay UI. The SECRET key is NEVER placed here — it is a Supabase Edge Function
# secret (see PAYSTACK-SETUP.md). Leave blank to keep payments dormant.
VITE_PAYSTACK_PUBLIC_KEY=

# Accounts used by the QA / verification harnesses in scripts/.
# Real values belong in .env, which is gitignored. Never commit them.
# Not VITE_-prefixed, so Vite never ships them to the browser bundle.
QA_EMAIL_ADMIN=
QA_PASSWORD_ADMIN=
QA_PASSWORD_STAGE3=
QA_PASSWORD_STAGE4=
QA_PASSWORD_STAGE5=

# ---- Loam (the N-ATLaS assistant) ----------------------------------------
# NOT VITE_-prefixed, deliberately. A VITE_ variable is compiled into the
# browser bundle and served to every visitor; these are read only by the dev
# middleware (Node) and later by the Edge Function (Deno). The browser never
# learns the inference URL and never calls the model directly.
#
# LOAM_INFERENCE_URL   where the model is served. Defaults to local Ollama.
#                      This is the one knob that moves inference to a GPU host
#                      or a hosted endpoint without touching Loam's code.
# LOAM_MODEL           which tag to call. Lets the quantisation change without
#                      a rebuild.
# LOAM_INFERENCE_TOKEN only if inference ever sits behind a gateway. Leave
#                      blank for local Ollama, which needs no auth.
LOAM_INFERENCE_URL=http://127.0.0.1:11434
LOAM_MODEL=natlas-q4km:latest
LOAM_INFERENCE_TOKEN=

# --- Voice input (local speech-to-text) -------------------------------------
# OFF by default. Three independent switches are needed, deliberately: a
# microphone pipeline that comes up by accident is a privacy incident, not a
# bug. See scripts/stt-worker/README.md.
#
#   1. start the Python worker by hand (it never starts with Vite)
#   2. LOAM_STT_ENABLED=1 below, or the dev server registers no route
#   3. enableLocalYorubaStt() in the browser, which nothing calls for you
#
# NONE of these is a VITE_ variable, so none reaches the browser bundle. The
# worker secret in particular is server-side only: the browser authenticates
# to the dev server with its Supabase JWT, and the dev server authenticates to
# the worker with this secret. The two never meet.
LOAM_STT_ENABLED=
# Loopback port for the worker. The host is always 127.0.0.1 and is NOT
# configurable: a route whose destination can be redirected is a server-side
# request forgery waiting to happen.
LOAM_STT_WORKER_PORT=8111
# 32+ characters of random data, shared with the worker process only.
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
LOAM_STT_WORKER_SECRET=

# --- Inference provider (server-side only) ----------------------------------
# Which model answers a chat turn. Read by the dev middleware AND by the
# deployable backend in server/. None of these is a VITE_ variable, so none
# reaches the browser bundle.
#
#   LOAM_PROVIDER   "hosted" | "ollama". Omit to infer: hosted when
#                   LOAM_HOSTED_MODEL or LOAM_HOSTED_TOKEN is set, else ollama.
#
# PRODUCTION REFUSES OLLAMA. A deployed service cannot reach a laptop, so
# resolveAdapter() throws at startup rather than accepting traffic it cannot
# serve. Set LOAM_ENV=production on real deployments and leave it unset (or
# "development") locally.
LOAM_PROVIDER=
LOAM_ENV=

# Hosted provider: an OpenAI-compatible chat-completions endpoint.
# LOAM_HOSTED_TOKEN is a SECRET -- set it in the host's secret manager, never
# here and never in a commit.
LOAM_HOSTED_MODEL=
LOAM_HOSTED_TOKEN=
# Defaults to the Hugging Face router when empty. Must not be a local address
# in production; startup rejects 127.0.0.1, localhost, ::1 and 0.0.0.0.
LOAM_HOSTED_BASE_URL=
LOAM_HOSTED_TIMEOUT_MS=

# --- Deployable backend (server/) -------------------------------------------
# PORT is supplied by the hosting platform; the value here is only a local
# default. HOST binds 0.0.0.0 so a container's health check can reach it.
PORT=8787
HOST=0.0.0.0
# Browser origins allowed to call the backend, comma-separated. NOT defaulted
# to "*": a wildcard would let any page read answers meant for a member.
# Example: https://app.example.com,https://staging.example.com
LOAM_ALLOWED_ORIGINS=

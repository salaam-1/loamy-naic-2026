{
  "name": "loamy-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Loamy — Nigeria's Agricultural Operating System. Stage 1: Foundation.",
  "type": "module",
  "scripts": {
    "dev": "vite --mode test --port 5173 --strictPort",
    "dev:production": "vite --port 5399 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/check-release-env.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run --config vitest.security.config.ts",
    "reachability": "node scripts/function-reachability.mjs",
    "dev:test": "vite --mode test --port 5173 --strictPort",
    "verify:release-env": "node scripts/check-release-env.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start:server": "node dist-server/loam-server.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "jsdom": "^25.0.1",
    "playwright": "1.49",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}

# Staging / test environment. Copy to `.env.test` and fill in.
#
# `.env.test` is gitignored. Never put production values in it: every guard in
# scripts/_environment.mjs and tests/helpers/environment.ts refuses to run when
# these point at a protected project (see config/environments.json).
#
# WHAT USES THIS FILE
#   node scripts/*.mjs      mutation-heavy verification and QA harnesses
#   npm run test:security   the RLS / security suite
#   npm run dev:test        the dev server, so browser-driven QA writes here too
#
# Vite reads this file when started with `--mode test`, which is why the
# VITE_-prefixed pair is duplicated below: the Node scripts read the LOAMY_TEST_
# names, and the browser app reads the VITE_ ones.

# ---- read by the Node scripts and the security suite ----------------------
LOAMY_TEST_SUPABASE_URL=https://REPLACE-WITH-STAGING-REF.supabase.co
LOAMY_TEST_SUPABASE_ANON_KEY=

# Persistent admin fixture ON STAGING. Optional: admin-scoped tests skip
# cleanly when it is absent rather than reporting a false security failure.
LOAMY_TEST_ADMIN_EMAIL=
LOAMY_TEST_ADMIN_PASSWORD=

# ---- read by the browser app under `npm run dev:test` ---------------------
# Same staging project, expressed the way Vite expects.
VITE_SUPABASE_URL=https://REPLACE-WITH-STAGING-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Staging must not carry live payment keys. Leave blank, or use a test key.
VITE_PAYSTACK_PUBLIC_KEY=

# ---- Loam (the N-ATLaS assistant) ----------------------------------------
# NOT VITE_-prefixed, deliberately. A VITE_ variable is compiled into the
# browser bundle and served to every visitor; these are read only by the dev
# middleware (Node) and later by the Edge Function (Deno). The browser never
# learns the inference URL and never calls the model directly.
#
# LOAM_INFERENCE_URL   where the model is served. Defaults to local Ollama.
#                      This is the one knob that moves inference to a GPU host
#                      or a hosted endpoint without touching Loam's code.
# LOAM_MODEL           which tag to call. Lets the quantisation change without
#                      a rebuild.
# LOAM_INFERENCE_TOKEN only if inference ever sits behind a gateway. Leave
#                      blank for local Ollama, which needs no auth.
# Blank here on purpose: this template carries NAMES ONLY, never values (a test
# enforces that). Leaving them blank also means the adapter's own defaults apply
# -- local Ollama and natlas-q4km:latest -- which is what staging development
# wants. Set them when inference moves off this machine.
LOAM_INFERENCE_URL=
LOAM_MODEL=
LOAM_INFERENCE_TOKEN=
